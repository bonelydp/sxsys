<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.PageViewMapper">

    <update id="increment">
        UPDATE page_view SET count = count + 1 WHERE view_type = #{viewType}
    </update>

    <select id="selectAll" resultType="com.example.pojo.PageView">
        SELECT * FROM page_view
    </select>

</mapper>
